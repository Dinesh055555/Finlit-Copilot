# Copy to .env for local runs, or add these in Render under Environment.

# Public URL of your app, no trailing slash (Render gives you https://<name>.onrender.com)
APP_BASE_URL=https://finlit-copilot.onrender.com
# Protects the live Zerodha portfolio and alert settings. Demo portfolios stay open for judges.
APP_PASSCODE=choose-a-passcode

# Zerodha Kite Connect (developers.kite.trade). Redirect URL: <APP_BASE_URL>/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
# Set true only if you bought the Kite Connect plan with market data (Rs 500/month)
KITE_MARKET_DATA=false

# Phone alerts. ntfy is free; Pushover rings through silent mode on iPhone.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Optional: Claude classifies news (falls back to transparent rules without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: Marketaux ticker-tagged news with sentiment (free tier is 100 calls a day)
MARKETAUX_TOKEN=

# Optional tuning
NEWS_POLL_MINUTES=5
HOLDINGS_POLL_SECONDS=60
